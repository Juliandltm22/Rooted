# Optional: existing server-side Gardener/plan endpoint.
EXPO_PUBLIC_GARDEN_PLAN_ENDPOINT=

# Optional: public URL for Rooted's server-side TTS adapter. Do not put the
# ElevenLabs API key in this file or any EXPO_PUBLIC_ variable.
EXPO_PUBLIC_GUIDED_TTS_ENDPOINT=

# Optional: HTTPS URL of a licensed, CORS-enabled looping ambient track.
EXPO_PUBLIC_GUIDED_AMBIENT_AUDIO_URL=
